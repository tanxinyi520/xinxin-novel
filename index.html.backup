<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>欣欣小说 - 发现你的下一本好书</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome -->
  <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
  
  <!-- 自定义Tailwind配置 -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#6366f1', // 主色调：靛蓝色
            secondary: '#ec4899', // 辅助色：粉红色
            accent: '#8b5cf6', // 强调色：紫色
            sidebar: {
              bg: "#FFFFFF",
              text: "#333333",
              hover: "#F5F5F5",
              border: "#EAEAEA"
            }
          }
        }
      }
    }
  </script>
  
  <!-- 自定义工具类 -->
  <style type="text/tailwindcss">
    @layer utilities {
      .card-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      .card-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
      }
      .scrollbar-hide {
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }
      .animate-fade-in {
        animation: fadeIn 0.5s ease forwards;
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }
    }
  </style>
  
  <!-- 全局样式 -->
  <style>
    html {
      scroll-behavior: smooth;
    }
    .page {
      display: none;
    }
    .page.active {
      display: block;
    }
    .book-card {
      cursor: pointer;
    }
  </style>
</head>
<body class="bg-gray-50 font-sans text-gray-800">
  <!-- 侧边栏 -->
  <div id="sidebar" class="fixed top-0 left-0 h-full w-64 bg-sidebar-bg border-r border-sidebar-border transform -translate-x-full transition-transform duration-300 ease-in-out z-40 overflow-y-auto">
    <!-- 侧边栏头部 -->
    <div class="p-4 border-b border-sidebar-border flex justify-between items-center">
      <div class="flex items-center">
        <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
          <i class="fa fa-book text-primary text-xl"></i>
        </div>
        <div class="ml-3">
          <h3 class="font-medium text-sidebar-text">游客用户</h3>
          <p class="text-xs text-gray-500">登录后享受更多功能</p>
        </div>
      </div>
      <button id="closeSidebar" class="p-2 rounded-full hover:bg-sidebar-hover transition-colors">
        <i class="fa fa-times text-sidebar-text"></i>
      </button>
    </div>
    
    <!-- 侧边栏导航 -->
    <nav class="p-4">
      <div class="space-y-2">
        <a href="#home" class="nav-link flex items-center gap-3 p-3 rounded-lg bg-primary/10 text-primary font-medium hover:bg-primary/20 transition-colors">
          <i class="fa fa-home text-lg"></i>
          <span>首页</span>
        </a>
        <a href="#discover" class="nav-link flex items-center gap-3 p-3 rounded-lg text-sidebar-text hover:bg-sidebar-hover transition-colors">
          <i class="fa fa-compass text-lg"></i>
          <span>发现好书</span>
        </a>
        <a href="#ranking" class="nav-link flex items-center gap-3 p-3 rounded-lg text-sidebar-text hover:bg-sidebar-hover transition-colors">
          <i class="fa fa-trophy text-lg"></i>
          <span>排行榜</span>
        </a>
        <a href="#bookshelf" class="nav-link flex items-center gap-3 p-3 rounded-lg text-sidebar-text hover:bg-sidebar-hover transition-colors">
          <i class="fa fa-bookmark text-lg"></i>
          <span>我的书架</span>
        </a>
        <a href="#history" class="nav-link flex items-center gap-3 p-3 rounded-lg text-sidebar-text hover:bg-sidebar-hover transition-colors">
          <i class="fa fa-history text-lg"></i>
          <span>阅读历史</span>
        </a>
        <a href="#download" class="nav-link flex items-center gap-3 p-3 rounded-lg text-sidebar-text hover:bg-sidebar-hover transition-colors">
          <i class="fa fa-download text-lg"></i>
          <span>下载管理</span>
        </a>
        <a href="#help" class="nav-link flex items-center gap-3 p-3 rounded-lg text-sidebar-text hover:bg-sidebar-hover transition-colors">
          <i class="fa fa-question-circle text-lg"></i>
          <span>帮助中心</span>
        </a>
        <a href="#settings" class="nav-link flex items-center gap-3 p-3 rounded-lg text-sidebar-text hover:bg-sidebar-hover transition-colors">
          <i class="fa fa-cog text-lg"></i>
          <span>设置</span>
        </a>
      </div>
    </nav>
  </div>
  
  <!-- 侧边栏遮罩 -->
  <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 z-30"></div>
  
  <!-- 主内容区 -->
  <div class="ml-0 md:ml-64 transition-all duration-300">
    <!-- 顶部导航栏 -->
    <header class="fixed top-0 left-0 right-0 md:left-64 bg-white shadow-sm z-20 transition-all duration-300">
      <div class="container mx-auto px-4 py-3 flex items-center justify-between">
        <!-- 移动端菜单按钮 -->
        <button id="openSidebar" class="md:hidden p-2 rounded-full hover:bg-gray-100 transition-colors">
          <i class="fa fa-bars text-gray-700"></i>
        </button>
        
        <!-- Logo -->
        <div class="flex items-center">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
            <i class="fa fa-book text-primary text-xl"></i>
          </div>
          <h1 class="ml-2 text-xl font-bold text-gray-800">欣欣小说</h1>
        </div>
        
        <!-- 桌面端导航 -->
        <nav class="hidden md:flex items-center space-x-6">
          <a href="#home" class="desktop-nav-link text-primary font-medium hover:text-primary/80 transition-colors">首页</a>
          <a href="#discover" class="desktop-nav-link text-gray-600 hover:text-primary transition-colors">发现好书</a>
          <a href="#ranking" class="desktop-nav-link text-gray-600 hover:text-primary transition-colors">排行榜</a>
          <a href="#bookshelf" class="desktop-nav-link text-gray-600 hover:text-primary transition-colors">我的书架</a>
        </nav>
        
        <!-- 搜索框 -->
        <div class="hidden md:block relative w-64">
          <input type="text" placeholder="搜索小说..." class="w-full pl-10 pr-4 py-2 rounded-full border border-gray-300 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
          <i class="fa fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
        </div>
        
        <!-- 用户菜单 -->
        <div class="flex items-center space-x-4">
          <button class="p-2 rounded-full hover:bg-gray-100 transition-colors">
            <i class="fa fa-bell text-gray-600"></i>
          </button>
          <button class="p-2 rounded-full hover:bg-gray-100 transition-colors">
            <i class="fa fa-comment-o text-gray-600"></i>
          </button>
          <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center overflow-hidden cursor-pointer hover:opacity-90 transition-opacity">
            <img src="https://picsum.photos/seed/user/100/100" alt="用户头像" class="w-full h-full object-cover">
          </div>
        </div>
      </div>
    </header>
    
    <!-- 主内容 -->
    <main class="pt-16 pb-12">
      <!-- 首页内容 -->
      <div id="home" class="page active">
        <div class="container mx-auto px-4 py-6">
          <h2 class="text-2xl font-bold mb-6">首页</h2>
          <div class="bg-white rounded-xl shadow-sm p-4">
            <p class="text-center py-12 text-gray-500">
              <i class="fa fa-home text-5xl mb-3"></i>
              <br>
              首页内容正在建设中
            </p>
          </div>
        </div>
      </div>
      
      <!-- 发现页面 -->
      <div id="discover" class="page">
        <div class="container mx-auto px-4 py-6">
          <h2 class="text-2xl font-bold mb-6">发现好书</h2>
          
          <!-- 搜索框 -->
          <div class="bg-white rounded-xl shadow-sm p-4 mb-8 animate-fade-in">
            <div class="relative">
              <input type="text" placeholder="搜索书名、作者或分类" class="w-full pl-10 pr-4 py-3 rounded-full border border-gray-200 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary">
              <i class="fa fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
            </div>
          </div>
          
          <!-- 热门分类 -->
          <div class="mb-10 animate-fade-in" style="animation-delay: 0.1s;">
            <h3 class="text-xl font-bold mb-4 flex items-center">
              <i class="fa fa-th-large text-primary mr-2"></i>
              热门分类
            </h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
              <a href="#" class="category-tag bg-primary/10 text-primary p-4 rounded-xl flex flex-col items-center justify-center text-center hover:shadow-md transition-shadow">
                <i class="fa fa-bolt text-xl mb-2"></i>
                <span class="text-sm font-medium">玄幻</span>
              </a>
