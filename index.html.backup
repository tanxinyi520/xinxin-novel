                <div class="mt-2">
                  <h4 class="font-medium text-sm line-clamp-2">医道巅峰：拯救生命</h4>
                  <p class="text-xs text-gray-500">作者：白衣天使</p>
                  <div class="flex items-center justify-between mt-1">
                    <div class="flex items-center text-xs text-yellow-500">
                      <i class="fa fa-star"></i>
                      <span class="ml-1">8.5</span>
                    </div>
                    <span class="text-xs text-gray-500">65.4万</span>
                  </div>
                </div>
              </div>
              <!-- 小说12 -->
              <div class="book-card card-hover cursor-pointer">
                <div class="relative">
                  <img src="https://picsum.photos/seed/discover12/200/300" alt="小说封面" class="w-full h-48 object-cover rounded-lg">
                  <div class="absolute top-2 right-2 bg-gray-500 text-white text-xs px-2 py-1 rounded">
                    其他
                  </div>
                </div>
                <div class="mt-2">
                  <h4 class="font-medium text-sm line-clamp-2">神秘世界：未知探索</h4>
                  <p class="text-xs text-gray-500">作者：探险家</p>
                  <div class="flex items-center justify-between mt-1">
                    <div class="flex items-center text-xs text-yellow-500">
                      <i class="fa fa-star"></i>
                      <span class="ml-1">8.4</span>
                    </div>
                    <span class="text-xs text-gray-500">54.3万</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- 排行榜页面 -->
      <div id="ranking" class="page">
        <div class="container mx-auto px-4 py-6">
          <h2 class="text-2xl font-bold mb-6">排行榜</h2>
          <div class="bg-white rounded-xl shadow-sm p-4">
            <p class="text-center py-12 text-gray-500">
              <i class="fa fa-trophy text-5xl mb-3"></i>
              <br>
              排行榜内容正在建设中
            </p>
          </div>
        </div>
      </div>
      
      <!-- 我的书架页面 -->
      <div id="bookshelf" class="page">
        <div class="container mx-auto px-4 py-6">
          <h2 class="text-2xl font-bold mb-6">我的书架</h2>
          <div class="bg-white rounded-xl shadow-sm p-4">
            <p class="text-center py-12 text-gray-500">
              <i class="fa fa-bookmark-o text-5xl mb-3"></i>
              <br>
              书架为空，快去添加小说吧！
            </p>
          </div>
        </div>
      </div>
      
      <!-- 阅读历史页面 -->
      <div id="history" class="page">
        <div class="container mx-auto px-4 py-6">
          <h2 class="text-2xl font-bold mb-6">阅读历史</h2>
          <div class="bg-white rounded-xl shadow-sm p-4">
            <p class="text-center py-12 text-gray-500">
              <i class="fa fa-history text-5xl mb-3"></i>
              <br>
              暂无阅读历史
            </p>
          </div>
        </div>
      </div>
      
      <!-- 下载管理页面 -->
      <div id="download" class="page">
        <div class="container mx-auto px-4 py-6">
          <h2 class="text-2xl font-bold mb-6">下载管理</h2>
          <div class="bg-white rounded-xl shadow-sm p-4">
            <p class="text-center py-12 text-gray-500">
              <i class="fa fa-download text-5xl mb-3"></i>
              <br>
              暂无下载任务
            </p>
          </div>
        </div>
      </div>
      
      <!-- 帮助中心页面 -->
      <div id="help" class="page">
        <div class="container mx-auto px-4 py-6">
          <h2 class="text-2xl font-bold mb-6">帮助中心</h2>
          <div class="bg-white rounded-xl shadow-sm p-4">
            <p class="text-center py-12 text-gray-500">
              <i class="fa fa-question-circle text-5xl mb-3"></i>
              <br>
              帮助中心内容正在建设中
            </p>
          </div>
        </div>
      </div>
      
      <!-- 设置页面 -->
      <div id="settings" class="page">
        <div class="container mx-auto px-4 py-6">
          <h2 class="text-2xl font-bold mb-6">设置</h2>
          <div class="bg-white rounded-xl shadow-sm p-4">
            <p class="text-center py-12 text-gray-500">
              <i class="fa fa-cog text-5xl mb-3"></i>
              <br>
              设置功能正在建设中
            </p>
          </div>
        </div>
      </div>
    </main>
  </div>
  
  <!-- JavaScript -->
  <script>
    // DOM加载完成后执行
    document.addEventListener('DOMContentLoaded', function() {
      // 页面切换功能
      function showPage(pageId) {
        // 隐藏所有页面
        const pages = document.querySelectorAll('.page');
        pages.forEach(page => {
          page.classList.remove('active');
        });
        
        // 显示目标页面
        const targetPage = document.getElementById(pageId);
        if (targetPage) {
          targetPage.classList.add('active');
        }
        
        // 更新导航链接状态
        const navLinks = document.querySelectorAll('.nav-link, .desktop-nav-link');
        navLinks.forEach(link => {
          link.classList.remove('bg-primary/10', 'text-primary', 'font-medium', 'hover:bg-primary/20');
          link.classList.add('text-sidebar-text', 'hover:bg-sidebar-hover');
          
          // 更新桌面端导航
          if (link.classList.contains('desktop-nav-link')) {
            link.classList.remove('text-primary');
            link.classList.add('text-gray-600');
          }
        });
        
        // 设置当前导航为活动状态
        const activeLink = document.querySelector(`[href="#${pageId}"]`);
        if (activeLink) {
          activeLink.classList.add('bg-primary/10', 'text-primary', 'font-medium', 'hover:bg-primary/20');
          activeLink.classList.remove('text-sidebar-text', 'hover:bg-sidebar-hover');
          
          // 更新桌面端导航
          if (activeLink.classList.contains('desktop-nav-link')) {
            activeLink.classList.add('text-primary');
            activeLink.classList.remove('text-gray-600');
          }
        }
        
        // 关闭侧边栏（如果是移动端）
        closeSidebar();
      }
      
      // 侧边栏功能
      const openSidebarBtn = document.getElementById('openSidebar');
      const closeSidebarBtn = document.getElementById('closeSidebar');
      const sidebar = document.getElementById('sidebar');
      const sidebarOverlay = document.getElementById('sidebarOverlay');
      
      function openSidebar() {
        sidebar.classList.remove('-translate-x-full');
        sidebarOverlay.classList.remove('opacity-0', 'pointer-events-none');
      }
      
      function closeSidebar() {
        sidebar.classList.add('-translate-x-full');
        sidebarOverlay.classList.add('opacity-0', 'pointer-events-none');
      }
      
      openSidebarBtn.addEventListener('click', openSidebar);
      closeSidebarBtn.addEventListener('click', closeSidebar);
      sidebarOverlay.addEventListener('click', closeSidebar);
      
      // 导航链接点击事件
      const navLinks = document.querySelectorAll('.nav-link, .desktop-nav-link');
      navLinks.forEach(link => {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          const pageId = this.getAttribute('href').substring(1);
          showPage(pageId);
        });
      });
      
      // 小说卡片点击事件
      const bookCards = document.querySelectorAll('.card-hover, .book-card');
      bookCards.forEach(card => {
        card.addEventListener('click', function() {
          // 获取当前页面ID
          const currentPage = document.querySelector('.page.active').id;
          window.location.href = `novel_detail.html?from=${currentPage}`;
        });
      });
      
      // 从URL参数加载页面
      const urlParams = new URLSearchParams(window.location.search);
      const initialPage = urlParams.get('page');
      if (initialPage) {
        showPage(initialPage);
      }
    });
  </script>
</body>
</html>