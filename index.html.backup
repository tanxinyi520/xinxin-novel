              <a href="#" class="category-tag bg-teal-500/10 text-teal-500 p-4 rounded-xl flex flex-col items-center justify-center text-center hover:shadow-md transition-shadow">
                <i class="fa fa-graduation-cap text-xl mb-2"></i>
